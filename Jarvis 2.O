import os
import json
import speech_recognition as sr
import pyttsx3
import requests
import webbrowser
import subprocess
import datetime
import time
import pyautogui
import wikipedia
import psutil
import screen_brightness_control as sbc
import pygame
import threading
from googletrans import Translator

# Initialize components
recognizer = sr.Recognizer()
microphone = sr.Microphone()
engine = pyttsx3.init()
translator = Translator()

# Set up voices for different languages
voices = engine.getProperty('voices')
engine.setProperty('voice', voices[0].id)  # Default voice

# Configuration
DEEPSEEK_API_KEY = "your_deepseek_api_key_here"  # Replace with your actual API key
DEEPSEEK_API_URL = "https://api.deepseek.com/v1/chat/completions"

# Set up pygame for wake word detection
pygame.mixer.init()
wake_sound = pygame.mixer.Sound("wake_sound.wav")  # Add a short sound file

# Function to speak text
def speak(text, language='en'):
    try:
        # If language is not English, translate it
        if language != 'en':
            translation = translator.translate(text, dest=language)
            text = translation.text
        
        engine.say(text)
        engine.runAndWait()
    except Exception as e:
        print(f"Error in speak function: {e}")

# Function to get response from DeepSeek API
def get_deepseek_response(prompt):
    headers = {
        "Authorization": f"Bearer {DEEPSEEK_API_KEY}",
        "Content-Type": "application/json"
    }
    
    data = {
        "model": "deepseek-chat",
        "messages": [
            {"role": "system", "content": "You are Jarvis, a helpful AI assistant that can control computers and provide information."},
            {"role": "user", "content": prompt}
        ],
        "temperature": 0.7
    }
    
    try:
        response = requests.post(DEEPSEEK_API_URL, headers=headers, json=data)
        response.raise_for_status()
        return response.json()["choices"][0]["message"]["content"]
    except Exception as e:
        return f"Error: {str(e)}"

# Function to listen for voice input
def listen():
    with microphone as source:
        print("Listening...")
        recognizer.adjust_for_ambient_noise(source)
        audio = recognizer.listen(source)
    
    try:
        print("Recognizing...")
        query = recognizer.recognize_google(audio, language='en')
        print(f"User said: {query}")
        return query.lower()
    except sr.UnknownValueError:
        return "Sorry, I didn't catch that."
    except sr.RequestError:
        return "Sorry, my speech service is down."

# Function to detect wake word
def detect_wake_word():
    with microphone as source:
        recognizer.adjust_for_ambient_noise(source)
        while True:
            print("Waiting for wake word 'Jarvis'...")
            audio = recognizer.listen(source)
            
            try:
                text = recognizer.recognize_google(audio).lower()
                if "jarvis" in text:
                    wake_sound.play()
                    return True
            except:
                pass

# Function to execute commands
def execute_command(command):
    # System control commands
    if "open" in command:
        app = command.split("open ")[-1]
        if "chrome" in app:
            os.startfile("C:\\Program Files\\Google\\Chrome\\Application\\chrome.exe")
            return f"Opening Chrome"
        elif "notepad" in app:
            os.system("notepad.exe")
            return f"Opening Notepad"
        elif "youtube" in app:
            webbrowser.open("https://www.youtube.com")
            return "Opening YouTube"
        elif "google" in app:
            webbrowser.open("https://www.google.com")
            return "Opening Google"
        else:
            try:
                os.system(f"start {app}")
                return f"Opening {app}"
            except:
                return f"Sorry, I couldn't open {app}"
    
    elif "close" in command:
        if "chrome" in command:
            os.system("taskkill /im chrome.exe /f")
            return "Closing Chrome"
        elif "notepad" in command:
            os.system("taskkill /im notepad.exe /f")
            return "Closing Notepad"
        else:
            return "I can close Chrome or Notepad for now."
    
    elif "shutdown" in command:
        os.system("shutdown /s /t 1")
        return "Shutting down the computer"
    
    elif "restart" in command:
        os.system("shutdown /r /t 1")
        return "Restarting the computer"
    
    elif "sleep" in command:
        os.system("rundll32.exe powrprof.dll,SetSuspendState 0,1,0")
        return "Putting computer to sleep"
    
    # Volume control
    elif "volume up" in command:
        pyautogui.press('volumeup')
        return "Increasing volume"
    
    elif "volume down" in command:
        pyautogui.press('volumedown')
        return "Decreasing volume"
    
    elif "mute" in command:
        pyautogui.press('volumemute')
        return "Muting volume"
    
    # Brightness control
    elif "increase brightness" in command:
        current_brightness = sbc.get_brightness()[0]
        sbc.set_brightness(min(100, current_brightness + 20))
        return "Increasing brightness"
    
    elif "decrease brightness" in command:
        current_brightness = sbc.get_brightness()[0]
        sbc.set_brightness(max(0, current_brightness - 20))
        return "Decreasing brightness"
    
    # System information
    elif "battery" in command:
        battery = psutil.sensors_battery()
        percent = battery.percent
        return f"Battery is at {percent} percent"
    
    elif "time" in command:
        current_time = datetime.datetime.now().strftime("%I:%M %p")
        return f"The current time is {current_time}"
    
    elif "date" in command:
        current_date = datetime.datetime.now().strftime("%B %d, %Y")
        return f"Today is {current_date}"
    
    elif "weather" in command:
        webbrowser.open("https://www.google.com/search?q=weather")
        return "Showing weather information"
    
    # Wikipedia search
    elif "wikipedia" in command or "wiki" in command:
        search_query = command.split("wikipedia")[-1].split("wiki")[-1].strip()
        try:
            result = wikipedia.summary(search_query, sentences=2)
            return f"According to Wikipedia: {result}"
        except:
            return "Sorry, I couldn't find information on that topic."
    
    # If no specific command is matched, use DeepSeek API
    else:
        return get_deepseek_response(command)

# Main function
def main():
    print("Jarvis AI Assistant Initializing...")
    speak("Hello, I am Jarvis. How can I assist you today?")
    
    while True:
        if detect_wake_word():
            speak("Yes, I'm listening")
            query = listen()
            
            if "goodbye" in query or "exit" in query or "quit" in query:
                speak("Goodbye! Have a great day!")
                break
            
            # Detect language preference
            language = 'en'  # Default to English
            if any(word in query for word in ["hindi", "हिंदी"]):
                language = 'hi'
            elif any(word in query for word in ["chinese", "中文", "汉语"]):
                language = 'zh-cn'
            elif any(word in query for word in ["russian", "русский"]):
                language = 'ru'
            elif any(word in query for word in ["japanese", "日本語"]):
                language = 'ja'
            elif any(word in query for word in ["spanish", "español"]):
                language = 'es'
            
            response = execute_command(query)
            speak(response, language)

if __name__ == "__main__":
    main()
